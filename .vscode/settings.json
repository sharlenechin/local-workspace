{
  // Point VS Code and its Jupyter extension at the workspace venv, so new
  // notebooks in any sub-folder default to the right interpreter.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "jupyter.notebookFileRoot": "${fileDirname}",
  // NO "files.associations" here. It is window-scoped, so VS Code ignores it
  // in a folder-level settings.json -- the "*.sql": "sql" that used to sit
  // here never took effect. It is now in ../../data-warehouse.code-workspace,
  // path-qualified, and mapped to `snowflake-sql` rather than `sql`: the
  // Snowflake extension gates its Run button on that exact language ID.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true
  },
  // The Snowflake extension looks for ~/.snowflake/connections.toml by
  // default. This machine keeps its connections in config.toml instead,
  // so point the extension at that file.
  "snowflake.connectionsConfigFile": "/Users/sharlenechin/.snowflake/config.toml"
}
